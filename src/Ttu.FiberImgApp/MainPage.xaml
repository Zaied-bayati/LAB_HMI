<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Ttu.FiberImgApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ttu.FiberImgApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" Opacity="0.8" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="Integrations" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.ZenStatus, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            <TextBlock Text="{x:Bind ViewModel.ThorlabsStatus, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh status" Command="{x:Bind ViewModel.RefreshStatusCommand}" />
                <Button Content="Connect ZEN (stub)" Command="{x:Bind ViewModel.ConnectZenCommand}" />
                <Button Content="Connect Thorlabs (stub)" Command="{x:Bind ViewModel.ConnectThorlabsCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.UpdateUri, Mode=OneWay}" TextWrapping="WrapWholeWords" IsTextSelectionEnabled="True" />
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" CornerRadius="8">
            <TextBlock TextWrapping="WrapWholeWords" Opacity="0.7"
                       Text="HMI layout and features will be added here. This shell wires DI, SQLite, Serilog, and stub hardware clients so those details can land without restructuring the solution." />
        </Border>
    </Grid>
</Page>
